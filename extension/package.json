{
  "name": "vscode-antigravity-mcp",
  "displayName": "VS Code Antigravity MCP Bridge",
  "description": "Exposes live VS Code editor state (cursor, selection, diagnostics, tabs) and Remote-SSH/WSL/Container file & terminal operations to MCP clients.",
  "publisher": "anhpi1",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscodeAntigravityMcp.markdownPreview",
        "displayName": "Antigravity Markdown Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vscodeAntigravityMcp.dumpState",
        "title": "VS Code MCP Bridge: Show Current Editor State"
      },
      {
        "command": "vscodeAntigravityMcp.openMarkdownPreview",
        "title": "Open Antigravity Markdown Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscodeAntigravityMcp.openMarkdownPreview",
          "when": "resourceExtname == .md && activeCustomEditorId != vscodeAntigravityMcp.markdownPreview",
          "group": "navigation"
        }
      ]
    }
  }
}
